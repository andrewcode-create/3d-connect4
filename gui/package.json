{
  "name": "3d-connect4-gui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:native": "make -C native",
    "test:native": "make -C native test",
    "dev": "npm run build:native && tsx watch server/index.ts",
    "build": "npm run build:native && tsc -b && vite build",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "test": "npm run test:native && vitest run",
    "check": "npm run test && npm run build && playwright test",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
